# Salin menjadi .env lalu sesuaikan. Jangan pakai komentar di belakang nilai
# (password boleh mengandung karakter # atau spasi; bungkus dengan tanda kutip).

APP_NAME="Test App Inventaris"
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id_ID

# --- MariaDB ---------------------------------------------------------------
# Server hanya memasang mariadb-client, jadi DB_HOST = IP/hostname server MariaDB.
# Jika MariaDB ada di server yang sama, isi DB_HOST=127.0.0.1
# atau pakai socket: DB_SOCKET=/run/mysqld/mysqld.sock
DB_HOST=192.168.1.10
DB_PORT=3306
DB_NAME=testapp
DB_USER=testapp
DB_PASS="ganti_dengan_password_kuat"
DB_CHARSET=utf8mb4
DB_SOCKET=

# --- Lain-lain -------------------------------------------------------------
UPLOAD_MAX_MB=5
# URL untuk uji ekstensi cURL (kosongkan untuk melewati uji koneksi keluar)
CURL_TEST_URL=https://example.com/
