# Salin menjadi .env lalu sesuaikan. Jangan pakai komentar di belakang nilai
# (password boleh mengandung karakter # atau spasi; bungkus dengan tanda kutip).
# Jika sebuah KEY ditulis lebih dari sekali, baris TERAKHIR yang berlaku.

APP_NAME="Test App Inventaris"
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id_ID

# --- MariaDB (SERVER 2 · db-01) ---------------------------------------------
# Server web hanya memasang mariadb-client, jadi DB_HOST = IP db-01.
DB_HOST=GANTI_IP_DB01
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_SOCKET=

# Staging: stg.devyourtech.com, web-02 / SERVER 3 (10.10.14.73)
DB_NAME=app_stg
DB_USER=stguser
DB_PASS="PasswordStg#2026"

# Produksi: app.devyourtech.com, web-01 / SERVER 1 (10.10.14.7)
# Di web-01, hapus tanda # pada 3 baris berikut (baris ini menimpa nilai staging di atas):
#DB_NAME=app_prod
#DB_USER=appuser
#DB_PASS="PasswordProd#2026"

# --- Lain-lain -------------------------------------------------------------
# Batas ukuran gambar di aplikasi (PHP sendiri mengizinkan s.d. 64M, lihat 99-custom.ini)
UPLOAD_MAX_MB=5
# URL untuk uji ekstensi cURL (kosongkan untuk melewati uji koneksi keluar)
CURL_TEST_URL=https://example.com/
